# Built binaries.
/bin/
/dist/

# The corpus and the working indexes. A corpus is gigabytes and is rebuilt from
# named checkouts, so it is described in the results rather than committed.
*.jsonl
/work/

# The checkouts the corpus is built from, which kura-corpus fetches at the
# commits pinned in corpus/sources.go and which come to a gigabyte and a half.
# The dot is what keeps them out of the way of the Go tools, which skip a
# directory whose name starts with one.
/.corpus/

# The vector datasets, which are half a gigabyte for SIFT and four for GIST and
# are fetched by kura-vectors from the addresses pinned in vectors/dataset.go.
/vecdata/

# The graphs, which are 28 thousand edges for ca-GrQc and 69 million for
# soc-LiveJournal, and are fetched by kura-graphs from the addresses pinned in
# graphs/dataset.go.
/graphdata/

# Results are committed on purpose, so results/ is deliberately not ignored.

# Rust build output.
/runners/rust/target/

# The ladybug shared library, which fetch.sh downloads at the version and the
# checksum pinned in third_party/ladybug/ladybug.json. The pin is committed and
# the six megabytes it names are not.
/third_party/ladybug/v*/

# Editors and platform noise.
.DS_Store
*.swp
.idea/
.vscode/
